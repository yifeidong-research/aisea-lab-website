---
import '@fontsource-variable/geist';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import { lab, navigation } from '../content/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = lab.mission } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title ? `${title} | ${lab.shortName}` : `${lab.shortName} | ${lab.name}`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <Brand />
        <nav aria-label="Main navigation">
          {navigation.map(({ label, href }) => (
            <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div><Brand /><p>{lab.affiliation} · Sydney, Australia</p></div>
        <a class="text-link" href="/contact/">Contact <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
  </body>
</html>
